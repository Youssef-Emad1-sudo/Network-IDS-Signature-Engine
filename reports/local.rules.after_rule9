alert http any any -> any any (msg:"LOCAL TEST Suspicious User-Agent"; flow:established,to_server; http.user_agent; content:"NIDS-Test-Agent"; sid:1000001; rev:1;)
alert dns any any -> any any (msg:"LOCAL TEST Suspicious DNS Query"; dns.query; content:"malware-test"; nocase; sid:1000002; rev:1;)
alert tcp any any -> any any (msg:"LOCAL TEST Possible TCP SYN Port Scan"; flags:S; flow:stateless; detection_filter: track by_src, count 5, seconds 10; sid:1000003; rev:1;)
alert icmp any any -> any any (msg:"LOCAL TEST ICMP Echo Request"; itype:8; sid:1000004; rev:1;)
alert tcp any any -> any 22 (msg:"LOCAL TEST SSH Connection"; flow:to_server; flags:S; sid:1000005; rev:1;)
alert tcp any any -> any 21 (msg:"LOCAL TEST FTP Connection"; flow:to_server; flags:S; sid:1000006; rev:1;)
alert tcp any any -> any 23 (msg:"LOCAL TEST Telnet Connection"; flow:to_server; flags:S; sid:1000007; rev:1;)
alert http any any -> any any (msg:"LOCAL TEST HTTP POST Request"; flow:established,to_server; http.method; content:"POST"; sid:1000008; rev:1;)
alert http any any -> any any (msg:"NIDS WEB Sensitive Configuration File Access"; flow:established,to_server; http.uri; content:"wp-config.php"; nocase; sid:1000009; rev:2;)
alert http any any -> any any (msg:"NIDS WEB Directory Traversal Attempt"; flow:established,to_server; http.uri.raw; content:"../"; sid:1000010; rev:2;)
alert icmp any any -> any any (msg:"NIDS RECON ICMP Ping Sweep"; itype:8; threshold: type both, track by_src, count 5, seconds 10; sid:1000011; rev:2;)
alert dns any any -> any any (msg:"NIDS DNS Suspicious XYZ Domain"; dns.query; content:".xyz"; nocase; sid:1000012; rev:1;)
alert tcp any any -> any any (msg:"NIDS DOS TCP SYN Flood"; flags:S; flow:stateless; threshold: type threshold, track by_src, count 20, seconds 10; sid:1000013; rev:1;)
alert tcp any any -> any 22 (msg:"NIDS BRUTE FORCE SSH Repeated Attempts"; flags:S; flow:stateless; threshold: type threshold, track by_src, count 5, seconds 60; sid:1000014; rev:1;)
alert tcp any any -> any 445 (msg:"NIDS RECON SMB Service Connection"; flags:S; flow:stateless; sid:1000015; rev:1;)
